---
import { readAll } from "../lib/markdoc/read";
import { project } from "../lib/markdoc/frontmatter.schema";
import PageLayout from "../layouts/PageLayout.astro";
import PageMeta from "../components/PageMeta.astro";
import { SITE_TITLE } from "../config";

const projects = await readAll({
  directory: "projects",
  frontmatterSchema: project,
});

const sortedProjects = projects
  .filter((p) => p.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );
---

<PageLayout>
  <PageMeta title={`Proyek | ${SITE_TITLE}`} slot="meta" />
  <section slot="main" class="py-6">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-text-heading mb-2">
        Proyek & Kode Sumber
      </h1>
      <p class="text-sm text-text-muted">
        Koleksi aplikasi, repositori open source, dan modul perangkat lunak yang pernah saya bangun.
      </p>
    </div>

    <div class="space-y-4">
      {
        sortedProjects.map((item) => {
          const formattedDate = new Date(item.frontmatter.date).toLocaleDateString("id-ID", {
            year: "numeric",
            month: "short",
          });
          return (
            <article class="p-5 rounded-lg bg-bg-code/15 border border-border-code/70 hover:border-primary-blue/40 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h2 class="text-lg font-bold text-text-heading">
                  <a
                    href={item.frontmatter.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="unset hover:text-primary-blue inline-flex items-center gap-1.5 transition-colors"
                  >
                    <span>{item.frontmatter.title}</span>
                    <i class="fa-solid fa-up-right-from-square text-xs text-text-muted" aria-hidden="true" />
                  </a>
                </h2>
                <time class="text-xs text-text-muted font-mono" datetime={item.frontmatter.date.toISOString()}>
                  {formattedDate}
                </time>
              </div>

              {item.frontmatter.description && (
                <p class="text-sm text-text-body leading-relaxed mb-4">
                  {item.frontmatter.description}
                </p>
              )}

              <div>
                <a
                  href={item.frontmatter.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="unset text-xs font-medium text-primary-blue hover:underline inline-flex items-center gap-1"
                >
                  <i class="fa-brands fa-github text-sm" aria-hidden="true" />
                  <span>Kunjungi Repository GitHub</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</PageLayout>
