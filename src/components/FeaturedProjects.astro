---
const CV_URL = "https://resmume.com/resume/ZmFxaWh5dWdvc0BnbWFpbC5jb206MjcxNzU=/";

const cvProjects = [
  {
    title: "ChatBot Aduan Berbasis AI (KPK RI)",
    category: "AI & Data Engineering",
    period: "Februari 2025 - Sekarang",
    description:
      "Pengembangan chatbot aduan menggunakan Python, arsitektur RAG, vector store Qdrant, dan LLM Studio. Mengonfigurasi engine vLLM di server GPU dengan model Qwen 3.8 dan Gemma 4 untuk otomatisasi penanganan aduan publik.",
    tech: ["Python", "RAG", "Qdrant", "vLLM", "LLM Studio", "Docker"],
    badge: "Enterprise AI",
    externalUrl: null,
  },
  {
    title: "Sistem Pengelolaan Barang Bukti di Rupbasan KPK",
    category: "Fullstack Web Application",
    period: "Juli 2023 - Desember 2024",
    description:
      "Aplikasi pengelolaan barang bukti dengan arsitektur fullstack (Laravel, Blade, jQuery). Mengintegrasikan RESTful API pihak ketiga secara realtime serta melakukan optimasi query PostgreSQL yang meningkatkan performa sebesar 25%.",
    tech: ["Laravel", "Blade", "jQuery", "PostgreSQL", "REST APIs"],
    badge: "Government System",
    externalUrl: null,
  },
  {
    title: "Web Aplikasi Pemanfaatan Aset Rampasan",
    category: "Backend & API Architecture",
    period: "Oktober 2022 - April 2023",
    description:
      "Penyediaan endpoint API untuk frontend dan dashboard pemantauan aset rampasan. Mengimplementasikan routing berkinerja tinggi, Eloquent ORM, dan pengamanan hak akses data aset institusional.",
    tech: ["Laravel (PHP)", "PostgreSQL", "REST APIs", "Eloquent ORM"],
    badge: "Backend & Data",
    externalUrl: null,
  },
  {
    title: "MyGram REST API Service",
    category: "Open Source Backend Service",
    period: "GitHub Repository",
    description:
      "Layanan backend RESTful API untuk platform penyimpanan foto dan komentar. Dibangun menggunakan bahasa pemrograman Go (Golang), framework Gin, GORM, dan database PostgreSQL.",
    tech: ["Go (Golang)", "Gin Framework", "GORM", "PostgreSQL", "JWT Auth"],
    badge: "Open Source",
    externalUrl: "https://github.com/Faqihyugos/mygram-go",
  },
];
---

<section class="mb-6 p-5 sm:p-6 rounded-xl border border-border-code/80 bg-bg-body shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="text-xl font-bold text-text-heading">Proyek Pilihan & Sistem Nyata</h3>
      <p class="text-xs text-text-muted mt-0.5">Sistem enterprise institusional dan repositori open-source sesuai CV</p>
    </div>
    <a
      href="/projects"
      class="unset text-xs font-semibold text-primary-blue hover:underline inline-flex items-center gap-1"
    >
      <span>Semua Proyek</span>
      <i class="fa-solid fa-arrow-right text-[10px]"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {cvProjects.map((item) => (
      <article class="p-4 rounded-lg bg-bg-code/20 border border-border-code/60 hover:border-primary-blue/50 flex flex-col justify-between transition-colors">
        <div>
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <div>
              <span class="text-[10px] font-semibold text-primary-blue uppercase tracking-wider block">
                {item.category}
              </span>
              <h4 class="text-sm font-bold text-text-heading mt-0.5">
                {item.title}
              </h4>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded font-medium bg-bg-body border border-border-code text-text-muted flex-shrink-0">
              {item.badge}
            </span>
          </div>

          <p class="text-xs text-text-body leading-relaxed mb-3 mt-2">
            {item.description}
          </p>
        </div>

        <div class="pt-2 border-t border-border-code/40">
          <div class="flex flex-wrap gap-1 mb-2.5">
            {item.tech.map((t) => (
              <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-bg-body border border-border-code text-text-muted">
                {t}
              </span>
            ))}
          </div>

          <div class="flex items-center justify-between text-xs text-text-muted">
            <span class="text-[11px] font-mono">{item.period}</span>
            {item.externalUrl ? (
              <a
                href={item.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="unset font-semibold text-primary-blue hover:underline inline-flex items-center gap-1 text-xs"
              >
                <i class="fa-brands fa-github"></i>
                <span>GitHub</span>
                <i class="fa-solid fa-up-right-from-square text-[9px]"></i>
              </a>
            ) : (
              <a
                href={CV_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="unset font-semibold text-primary-blue hover:underline inline-flex items-center gap-1 text-[11px]"
              >
                <span>Lihat di CV</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[8px]"></i>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
