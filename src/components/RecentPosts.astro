---
import { readAll } from "../lib/markdoc/read";
import { blog } from "../lib/markdoc/frontmatter.schema";

const allPosts = await readAll({
  directory: "blog",
  frontmatterSchema: blog,
});

const recentPosts = allPosts
  .filter((p) => p.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  )
  .slice(0, 4);
---

<section class="mb-6 p-5 sm:p-6 rounded-xl border border-border-code/80 bg-bg-body shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h3 class="text-xl font-bold text-text-heading">Artikel & Catatan Teknis</h3>
      <p class="text-xs text-text-muted mt-0.5">Tulisan seputar DevOps, DevSecOps, validasi API, Linux, dan arsitektur backend</p>
    </div>
    <a
      href="/blog"
      class="unset text-xs font-semibold text-primary-blue hover:underline inline-flex items-center gap-1"
    >
      <span>Lihat semua artikel</span>
      <i class="fa-solid fa-arrow-right text-[10px]"></i>
    </a>
  </div>

  <div class="space-y-3">
    {recentPosts.map((post) => {
      const formattedDate = new Date(post.frontmatter.date).toLocaleDateString(
        "id-ID",
        {
          year: "numeric",
          month: "short",
          day: "numeric",
        }
      );
      const isExternal = post.frontmatter.external;
      const targetUrl = isExternal ? post.frontmatter.url : `/blog/${post.slug}`;

      return (
        <article class="p-3.5 rounded-lg bg-bg-code/20 border border-border-code/60 hover:border-primary-blue/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 transition-colors">
          <div class="flex-1">
            <h4 class="text-sm font-semibold text-text-heading">
              <a
                href={targetUrl}
                target={isExternal ? "_blank" : "_self"}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="unset hover:text-primary-blue transition-colors inline-flex items-center gap-1.5"
              >
                <span>{post.frontmatter.title}</span>
                {isExternal && (
                  <i class="fa-solid fa-up-right-from-square text-xs text-text-muted"></i>
                )}
              </a>
            </h4>
            {post.frontmatter.description && (
              <p class="text-xs text-text-muted line-clamp-1 mt-1">
                {post.frontmatter.description}
              </p>
            )}
          </div>
          <div class="text-xs text-text-muted font-mono whitespace-nowrap">
            <time datetime={post.frontmatter.date.toISOString()}>
              {formattedDate}
            </time>
          </div>
        </article>
      );
    })}
  </div>
</section>
